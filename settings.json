// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tab_size": 2,
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    }
  },
  "prettier": {
    "allowed": true,
    "semi": false,
    "singleQuote": true,
    "bracketSameLine": false,
    "printWidth": 120,
    "singleAttributePerLine": true
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["typescript-language-server"],
      "formatter": "prettier"
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server"],
      "formatter": "prettier"
    },
    "Vue": {
      "formatter": "prettier"
    }
  },

  "agent": {
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking"
    },
    "model_parameters": [],
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "project_panel": {
    "dock": "right"
  },
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_weight": 500,
  "ui_font_family": "Monaspace Neon",
  "ui_font_weight": 500,
  "format_on_save": "off",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "JetBrains New Dark"
  }
}
